{
  "info": {
    "name": "URL Shortener Final API",
    "description": "Comprehensive endpoints for the URL Shortener project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/health",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "8000",
          "path": [ "health" ]
        }
      }
    },
    {
      "name": "2. Register User",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"testuser@test.in\",\n    \"password\": \"password123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:8000/api/v1/auth/create",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "8000",
          "path": [ "api", "v1", "auth", "create" ]
        }
      }
    },
    {
      "name": "3. Login User",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"testuser@test.in\",\n    \"password\": \"password123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:8000/api/v1/auth/login",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "8000",
          "path": [ "api", "v1", "auth", "login" ]
        }
      }
    },
    {
      "name": "4. Shorten URL",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"long_url\": \"https://www.youtube.com/watch?v=dQw4w9WgXcQ\",\n    \"name\": \"my-youtube-video\",\n    \"description\": \"A great video link.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:8000/api/v1/shorten",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "8000",
          "path": [ "api", "v1", "shorten" ]
        }
      }
    },
    {
      "name": "5. Get Info (All links)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
        ],
        "url": {
          "raw": "http://localhost:8000/api/v1/info?page=1&page_size=20",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "8000",
          "path": [ "api", "v1", "info" ],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "page_size", "value": "20" }
          ]
        }
      }
    },
    {
      "name": "6. Search Links",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
        ],
        "url": {
          "raw": "http://localhost:8000/api/v1/search?q=video&page=1&page_size=20",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "8000",
          "path": [ "api", "v1", "search" ],
          "query": [
            { "key": "q", "value": "video" },
            { "key": "page", "value": "1" },
            { "key": "page_size", "value": "20" }
          ]
        }
      }
    },
    {
      "name": "7. Redirect Link",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/YOUR_SHORT_CODE",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "8000",
          "path": [ "YOUR_SHORT_CODE" ]
        }
      }
    }
  ]
}
